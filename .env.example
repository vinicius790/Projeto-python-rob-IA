# Runtime
ROBIA_ENV=development
ROBIA_DEBUG=false
ROBIA_DATABASE_URL=sqlite:///./data/robia.db
ROBIA_LOG_LEVEL=INFO
ROBIA_PROVIDER=sandbox
ROBIA_DEFAULT_CURRENCY=BRL

# Authentication
# Local development may leave these blank. Production requires ADMIN_API_KEY or API_KEY.
ROBIA_API_KEY=
ROBIA_READ_API_KEY=
ROBIA_WRITE_API_KEY=
ROBIA_ADMIN_API_KEY=

# PII protection
# Change this outside local demo environments. It fingerprints CPF values before persistence.
ROBIA_PII_KEY=robia-dev-pii-key-change-me

# HTTP / browser surface
ROBIA_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ROBIA_ALLOWED_ORIGINS=
ROBIA_ENABLE_DOCS=true
ROBIA_ENABLE_DASHBOARD=true
ROBIA_ENABLE_METRICS=true
ROBIA_MAX_PAGE_SIZE=100
ROBIA_MAX_REQUEST_BYTES=1048576

# Provider reliability
ROBIA_PROVIDER_MAX_ATTEMPTS=3
ROBIA_PROVIDER_RETRY_BASE_SECONDS=0.05

# Analytics
ROBIA_ANOMALY_CONTAMINATION=0.08

# Database tuning
ROBIA_DB_POOL_SIZE=5
ROBIA_DB_MAX_OVERFLOW=10
ROBIA_DB_POOL_RECYCLE_SECONDS=1800
ROBIA_SQLITE_BUSY_TIMEOUT_MS=5000
